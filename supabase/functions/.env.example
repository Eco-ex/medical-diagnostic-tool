# Secrets for Supabase Edge Functions.
# Production: set via `supabase secrets set KEY=value` or the dashboard.
# Local (`supabase functions serve`): copy this file to `.env` in this directory.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the Edge
# Runtime and do not need to be set here.

# LlamaCloud — used by parse-document (Phase 4a)
LLAMA_CLOUD_API_KEY=
# Optional; defaults to https://api.cloud.eu.llamaindex.ai
LLAMA_CLOUD_BASE_URL=

# Voyage AI embeddings — used by embed-batch (Phase 4c)
VOYAGE_API_KEY=
# Optional; defaults to https://api.voyageai.com/v1/embeddings
VOYAGE_BASE_URL=
