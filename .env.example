# Copy this file to `.env.local` and fill in the values.

# Supabase (required) — server-side Postgres access. From the Supabase
# dashboard: Project Settings → API Keys. The secret key (`sb_secret_...`)
# bypasses Row Level Security, so keep it server-only and never expose it to
# the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Base URL for the API (optional). Leave unset to use this app's own /api
# routes (same-origin). Set it only to point the UI at a different backend host.
# NEXT_PUBLIC_API_URL=